# Copy to .env and fill in. Values here are placeholders — never commit
# real secrets (CLAUDE.md invariant: secret references by env-var name only).

MERGE0_REPO=your-org/your-repo
MERGE0_PUBLIC_URL=https://merge0.example.com

# Long random strings; all three must differ.
MERGE0_API_TOKEN=
MERGE0_RUNNER_TOKEN=
MERGE0_GITHUB_WEBHOOK_SECRET=

# GitHub App credentials (P0-11). Step-by-step walkthrough — including the
# exact permissions and events to tick — in docs/github-app-setup.md.
MERGE0_GITHUB_APP_ID=
MERGE0_GITHUB_INSTALLATION_ID=
# MUST be quoted: an unquoted multi-line PEM makes docker compose fail to
# read this entire file. Turn the downloaded .pem into a quoted one-liner:
#   awk 'BEGIN{printf "MERGE0_GITHUB_APP_PRIVATE_KEY=\""} {printf "%s\\n", $0} \
#        END{print "\""}' your-app.private-key.pem
MERGE0_GITHUB_APP_PRIVATE_KEY=

# Model access for the triage gate.
ANTHROPIC_API_KEY=

# Optional: Slack digest + interactive approvals.
MERGE0_SLACK_WEBHOOK_URL=
MERGE0_SLACK_SIGNING_SECRET=

# Optional: vendor pollers enabled in config/sources.toml reference their
# API credentials by env-var NAME — export those names here, e.g.:
# POSTHOG_API_KEY=
# SENTRY_API_TOKEN=
# MERGE0_MIXPANEL_SA_USER=          (service-account username)
# MERGE0_MIXPANEL_SA_SECRET=
# MERGE0_OPENPANEL_CLIENT_ID=       (a READ-mode client, not the default)
# MERGE0_OPENPANEL_CLIENT_SECRET=

# Optional: vendor webhook verification.
MERGE0_SENTRY_WEBHOOK_SECRET=
MERGE0_POSTHOG_WEBHOOK_TOKEN=
MERGE0_ZENDESK_WEBHOOK_SECRET=
MERGE0_DATADOG_WEBHOOK_TOKEN=
MERGE0_JIRA_WEBHOOK_TOKEN=
MERGE0_LINEAR_WEBHOOK_SECRET=

# Optional tuning (autonomy + budget live in config/gate.toml, not here).
# Escalation re-open: dismissed reports return when affected count grows
# this many times past the dismissal snapshot (0 = never re-open).
MERGE0_REOPEN_FACTOR=3
# Days a merged fix must stay quiet before it counts as confirmed.
MERGE0_EFFICACY_GRACE_DAYS=3
# Slack notification classes: comma list of reports,pr_ready (unset = both).
MERGE0_SLACK_NOTIFY=

# Delivery: what approval produces.
#   pr           (default) dispatch the runner; the PR is the artifact
#   story        file a tracker story INSTEAD — no runner, no PR. The
#                on-ramp for teams not yet ready for autonomous PRs.
#   story_and_pr file the story AND dispatch, so the board reflects the
#                work the agent is already doing.
# Independently of this, config/gate.toml's [delivery] min_confidence_for_pr
# routes Work Orders the gate is NOT confident in to a story instead of an
# agent — it only ever removes autonomy, and needs a tracker below.
MERGE0_DELIVERY_MODE=pr
# Jira story output (story / story_and_pr modes). Reuses the same
# credentials as Jira ingestion; setting MERGE0_JIRA_PROJECT enables it.
MERGE0_JIRA_PROJECT=
MERGE0_JIRA_BASE_URL=
MERGE0_JIRA_ISSUE_TYPE=Task
MERGE0_JIRA_EMAIL=
MERGE0_JIRA_API_TOKEN=

# Optional: credential broker preview surface (POST /broker/credentials).
MERGE0_BROKER_RUNNER_KEY=
# Optional: curated skill registry (GET /registry/skills + install PRs):
# directory with index.json + skills/<name>/, and the hex ed25519 pubkey.
MERGE0_REGISTRY_DIR=
MERGE0_REGISTRY_PUBKEY=

POSTGRES_PASSWORD=merge0
