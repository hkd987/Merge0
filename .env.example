# Copy to .env and fill in. Values here are placeholders — never commit
# real secrets (CLAUDE.md invariant: secret references by env-var name only).

MERGE0_REPO=your-org/your-repo
MERGE0_PUBLIC_URL=https://merge0.example.com

# Long random strings; all three must differ.
MERGE0_API_TOKEN=
MERGE0_RUNNER_TOKEN=
MERGE0_GITHUB_WEBHOOK_SECRET=

# GitHub App credentials (P0-11).
MERGE0_GITHUB_APP_ID=
MERGE0_GITHUB_APP_PRIVATE_KEY=
MERGE0_GITHUB_INSTALLATION_ID=

# Model access for the triage gate.
ANTHROPIC_API_KEY=

# Optional: Slack digest + interactive approvals.
MERGE0_SLACK_WEBHOOK_URL=
MERGE0_SLACK_SIGNING_SECRET=

# Optional: vendor pollers enabled in config/sources.toml reference their
# API credentials by env-var NAME — export those names here, e.g.:
# POSTHOG_API_KEY=
# SENTRY_API_TOKEN=

# Optional: vendor webhook verification.
MERGE0_SENTRY_WEBHOOK_SECRET=
MERGE0_POSTHOG_WEBHOOK_TOKEN=
MERGE0_ZENDESK_WEBHOOK_SECRET=
MERGE0_DATADOG_WEBHOOK_TOKEN=
MERGE0_JIRA_WEBHOOK_TOKEN=
MERGE0_LINEAR_WEBHOOK_SECRET=

POSTGRES_PASSWORD=merge0
